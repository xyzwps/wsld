<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="wsld.Pages.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:wsld.Core.ViewModels"
    xmlns:p="using:wsld.Core.Parsing"
>
    <!-- 功能 009 · AC4/AC5:按钮全部换成图标,静态文案走 Localizer 转换器(页面 DataContext 就是它)。
         图标按钮必须同时给 ToolTip 和 AutomationProperties.Name,否则读屏软件念不出这是什么按钮。 -->
    <!-- 布局:左栏容器列表 = 固定宽度,右栏容器详情 = 剩下的全部。
         左栏绝不能写 "*":星号列至少要装得下内容的期望宽度,
         工具栏(搜索框 + 开关 + 刷新键)一撑,窗口不够宽时右栏就被挤到只剩两三百像素,详情整块没法看。
         宽度按"行里最长的那串镜像名"来定:命令挪进详情之后,340 DIP 放得下名称、状态、镜像和那个启动键。
         根 Grid 只有一行(隐式 "*"),两栏都靠它拿到窗口高度:
         这里多写一行 RowDefinitions="Auto,..." 会把两栏塞进 Auto 行,
         它们便以"无限高"去测量,列表和详情各自的内容撑满后内部滚动条永远不出现。 -->
    <!-- 详情区两个页签的样式:不要单选钮那个圆点,选中只在文字下面画一条强调线。
         这里刻意不用 TabView —— 它自带一个"新建标签"的 + 按钮,而 Windows App SDK 2.5 上
         没有暴露关掉它的属性(XamlCompiler 直接报 Unknown member 'IsAddButtonVisible')。 -->
    <Page.Resources>
        <Style x:Key="TabRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,6,12,8" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <!-- 必须成对写:只在 Checked 态里把下划线拉出来,取消勾选时没人把它收回去,
                                         结果两个页签会同时带线(真机截图上看到的)。 -->
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Underline"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderText"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Underline"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderText"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Underline"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.08" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HeaderText"
                                                                           Storyboard.TargetProperty="Foreground">
                                                <DiscreteObjectKeyFrame Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="HeaderText" Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border x:Name="Underline" Height="2" Width="28" CornerRadius="1"
                                    VerticalAlignment="Bottom" Opacity="0"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid ColumnDefinitions="Auto,Auto,*">

        <!-- ===== 左栏:容器列表(固定宽度,不随窗口拉伸) ===== -->
        <Grid Grid.Column="0" Width="340">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 错误条 -->
            <InfoBar Grid.Row="0"
                     Margin="12,12,6,0"
                     Severity="Error"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     IsClosable="False"
                     Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

            <!-- 工具栏:固定宽度塞不下一整行,拆成两行 —— 上面整行搜索,下面过滤 + 刷新键。
                 ToggleSwitch 默认 MinWidth=154,不压成 0 就把右边的内容顶出去了(dev-notes §18)。 -->
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto" Padding="12,12,6,0">
                <TextBox x:Name="SearchBox"
                         PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=containers.search.placeholder}"
                         HorizontalAlignment="Stretch"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                    <ToggleSwitch x:Name="ShowStoppedToggle"
                                  MinWidth="0"
                                  OnContent="{Binding Converter={StaticResource LocText}, ConverterParameter=containers.show-stopped}"
                                  OffContent="{Binding Converter={StaticResource LocText}, ConverterParameter=containers.hide-stopped}"
                                  VerticalAlignment="Center"
                                  IsOn="{x:Bind ViewModel.ShowStopped, Mode=TwoWay}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing x:Name="BusyRing"
                                      Width="18" Height="18"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource IconOnlyButtonStyle}"
                                Content="&#xE895;"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=containers.refresh.tooltip}"
                                AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=action.refresh}"
                                Command="{x:Bind ViewModel.RefreshCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 汇总 -->
            <TextBlock Grid.Row="2"
                       Margin="12,12,6,4"
                       Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Border Grid.Row="3" Height="1" Margin="12,0,6,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- 容器列表:整行可点 —— 点一行 = 右栏立刻显示它的详情,
                 所以行内不再单独放「查看详情」按钮(少一个按钮,左栏也宽裕些)。
                 SelectionMode 用 Single 而不是 None:正在看的那一行会一直高亮,
                 右栏显示的是哪个容器,眼睛一对就知道。 -->
            <Grid Grid.Row="4" Margin="12,4,6,0">
                <ListView x:Name="ContainerList"
                          ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                          SelectionMode="Single"
                          SelectionChanged="ContainerList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ContainerItemViewModel">
                            <!-- 固定宽度后一行只塞得下「名称 + 操作按钮」:
                                 状态、镜像各自占一行,谁长谁出省略号,不再互相抢宽度。
                                 ID/网络/端口这类明细不进列表行,点这一行看右栏详情。
                                 整行都是点击区,悬停提示把被删掉的那个按钮的说明补回来。 -->
                            <StackPanel Spacing="3" Padding="0,6"
                                        ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.view-tooltip}"
                                        AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                             Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                             Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayName, Mode=OneWay}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Center">
                                        <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                                                      IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                      Visibility="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource IconOnlyButtonStyle}"
                                                Content="&#xE768;"
                                                ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=action.start.tooltip}"
                                                AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=action.start}"
                                                IsEnabled="{x:Bind CanStart, Mode=OneWay}"
                                                Command="{x:Bind StartCommand, Mode=OneTime}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Image, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyHint" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Style="{StaticResource EmptyStateIconStyle}" Glyph="&#xE8A1;" />
                    <TextBlock Style="{StaticResource EmptyStateTextStyle}"
                               Text="{Binding Converter={StaticResource LocText}, ConverterParameter=containers.empty}" />
                </StackPanel>
            </Grid>

            <!-- 状态栏 -->
            <TextBlock Grid.Row="5"
                       Margin="12,8,6,10"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="{x:Bind ViewModel.LastRefreshedAtText, Mode=OneWay}" />
        </Grid>

        <!-- ===== 分隔线 ===== -->
        <Border Grid.Column="1" Width="1" Margin="0,12"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- ===== 右栏:容器详情(两个页签:详情 / 日志) ===== -->
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*">
            <!-- 详情头部 -->
            <Grid Grid.Row="0" Padding="12,12,12,4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                  Visibility="{x:Bind HasDetail, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <TextBlock Grid.Column="0"
                           Text="{x:Bind DetailViewModel.DisplayName, Mode=OneWay}"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- 徽标要贴着标题,不能撑满整列:* 列上默认 Stretch 会把它拉成一条绿色横幅。 -->
                <Border Grid.Column="1" Style="{StaticResource RunningBadgeStyle}"
                        Visibility="{x:Bind DetailViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Converter={StaticResource LocText}, ConverterParameter=state.running}"
                               Style="{StaticResource BadgeTextStyle}" Foreground="White" />
                </Border>
                <Border Grid.Column="1" Style="{StaticResource StoppedBadgeStyle}"
                        Visibility="{x:Bind DetailViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Text="{Binding Converter={StaticResource LocText}, ConverterParameter=state.stopped}"
                               Style="{StaticResource BadgeTextStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                                  IsActive="{x:Bind DetailViewModel.IsBusy, Mode=OneWay}"
                                  Visibility="{x:Bind DetailViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource IconOnlyButtonStyle}"
                            Content="&#xE768;"
                            ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=action.start.tooltip}"
                            AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=action.start}"
                            IsEnabled="{x:Bind DetailViewModel.CanStart, Mode=OneWay}"
                            Command="{x:Bind DetailViewModel.StartCommand}" />
                    <Button Style="{StaticResource IconOnlyButtonStyle}"
                            Content="&#xE71A;"
                            ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=action.stop.tooltip}"
                            AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=action.stop}"
                            IsEnabled="{x:Bind DetailViewModel.CanStop, Mode=OneWay}"
                            Command="{x:Bind DetailViewModel.StopCommand}" />
                    <Button Style="{StaticResource IconOnlyButtonStyle}"
                            Content="&#xE72C;"
                            ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=action.restart.tooltip}"
                            AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=action.restart}"
                            IsEnabled="{x:Bind DetailViewModel.CanRestart, Mode=OneWay}"
                            Command="{x:Bind DetailViewModel.RestartCommand}" />
                    <Button Style="{StaticResource DangerIconButtonStyle}"
                            Content="&#xE74D;"
                            ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=action.delete.tooltip}"
                            AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=action.delete}"
                            IsEnabled="{x:Bind DetailViewModel.CanRemove, Mode=OneWay}"
                            Click="DetailRemoveButton_Click" />
                </StackPanel>
            </Grid>

            <!-- 详情错误条 -->
            <InfoBar Grid.Row="1"
                     Margin="12,0,12,4"
                     Severity="Error"
                     IsOpen="{x:Bind DetailHasError, Mode=OneWay}"
                     IsClosable="False"
                     Message="{x:Bind DetailError, Mode=OneWay}"
                     Visibility="{x:Bind HasDetail, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <!-- 页签条:只做选择,内容放在下面同一行的两块里按可见性切换。
                 不把面板塞进页签的 Content —— 那样每次切都要重建,
                 日志的滚动位置和已显示的行都得跟着丢。 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0"
                        Visibility="{x:Bind HasDetail, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <RadioButton x:Name="DetailTabRadio" GroupName="detailTab" IsChecked="True"
                             Style="{StaticResource TabRadioStyle}"
                             Checked="DetailTab_Checked"
                             Content="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.tab.detail}" />
                <RadioButton x:Name="LogsTabRadio" GroupName="detailTab"
                             Style="{StaticResource TabRadioStyle}"
                             Checked="DetailTab_Checked"
                             Content="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.tab.logs}" />
            </StackPanel>

            <!-- 详情内容:卡片宽度 = min(视口, 600 DIP),左右留白平分。
                 这里必须把面板宽度显式绑到 ScrollViewer 的实际宽度(用经典 Binding ElementName;
                 x:Bind 在解析顺序上拿不到还没建好的外层元素,绑出来是 0,整叠卡片直接不见):
                 它的呈现器是按"内容的期望宽度"摆放的,Stretch 与 HorizontalContentAlignment 都不起作用,
                 结果卡片会跟着数据忽宽忽窄(短标签的容器窄、长 JSON 的容器顶到封顶),
                 而且比视口窄时会被摆到右边去 —— 看着就是"有时不居中"。
                 横向滚动也照样关掉:开着时一条长标签就能把可滚动范围撑得比视口宽。
                 左右留白放在面板自己的 Padding 上,这样"视口宽"就是可用的全部内容宽。 -->
            <ScrollViewer x:Name="DetailScroller" Grid.Row="3" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,4,0,12"
                          Visibility="{x:Bind DetailContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="12" Padding="12,0,12,0" MaxWidth="624" HorizontalAlignment="Center"
                            Width="{Binding ActualWidth, ElementName=DetailScroller}">

                    <!-- 基本信息 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.section.basic}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.id}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind DetailViewModel.Id, Mode=OneWay}"
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.image}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind DetailViewModel.Image, Mode=OneWay}"
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.command}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind DetailViewModel.Command, Mode=OneWay}"
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.created}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind DetailViewModel.CreatedAt, Mode=OneWay}"
                                           IsTextSelectionEnabled="True" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.platform}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind DetailViewModel.Platform, Mode=OneWay}"
                                           IsTextSelectionEnabled="True" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.size}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind DetailViewModel.Size, Mode=OneWay}"
                                           IsTextSelectionEnabled="True" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 状态信息 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.section.status}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.state}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind DetailViewModel.State, Mode=OneWay}"
                                           IsTextSelectionEnabled="True" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.status}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind DetailViewModel.Status, Mode=OneWay}"
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.health}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind DetailViewModel.HealthStatus, Mode=OneWay}"
                                           IsTextSelectionEnabled="True" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 网络 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.section.network}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="12">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.ports}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind DetailViewModel.Ports, Mode=OneWay}"
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.networks}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind DetailViewModel.Networks, Mode=OneWay}"
                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 标签:wslc 交回来的是一整条逗号拼接的串,直接贴出来就是一堵读不动的墙,
                         所以拆成"键一行、值一行",键用等宽小字压暗。拆分规则见 ContainerLabelParser。 -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.section.labels}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="—"
                                       Visibility="{x:Bind DetailViewModel.HasLabels, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{x:Bind DetailViewModel.LabelEntries, Mode=OneWay}"
                                          Visibility="{x:Bind DetailViewModel.HasLabels, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="12" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="p:ContainerLabel">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Key, Mode=OneTime}"
                                                       FontFamily="{StaticResource CodeFont}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                       Visibility="{x:Bind HasKey, Mode=OneTime, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{x:Bind Value, Mode=OneTime}"
                                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== 日志页签的内容(功能 005) =====
                 两种读法各一个入口:「查看日志」一次性读当前能看到的;「实时日志」从点下去这一刻起
                 只收新行、不倒历史。已经显示的行停在实时时保留,换容器才清空。 -->
            <Grid Grid.Row="3" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8"
                  Padding="12,4,12,12"
                  Visibility="{x:Bind LogsContentVisible, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Content="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.read}"
                            ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.read-tooltip}"
                            Command="{x:Bind LogsViewModel.ReadCommand}" />
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Content="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.live}"
                            ToolTipService.ToolTip="{x:Bind LogsViewModel.FollowTooltip, Mode=OneWay}"
                            Command="{x:Bind LogsViewModel.FollowCommand}" />
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Content="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.live.stop}"
                            ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.live.stop-tooltip}"
                            Command="{x:Bind LogsViewModel.StopFollowCommand}" />
                    <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                                  IsActive="{x:Bind LogsViewModel.IsBusy, Mode=OneWay}"
                                  Visibility="{x:Bind LogsViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20">
                    <!-- 行数只在「查看日志」这条路上起作用,实时日志不看它(参数拼装里就不发 -n)。
                         SelectedItem 用代码回填:x:Bind TwoWay 在 ComboBox 上会赶上 ItemsSource 赋值那一次通知。 -->
                    <ComboBox x:Name="TailBox" Width="150" VerticalAlignment="Bottom"
                              Header="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.lines-header}"
                              IsEnabled="{x:Bind LogsViewModel.CanChangeOptions, Mode=OneWay}"
                              ItemsSource="{x:Bind LogsViewModel.TailOptions, Mode=OneTime}"
                              DisplayMemberPath="Label"
                              SelectionChanged="Tail_SelectionChanged" />
                    <CheckBox VerticalAlignment="Center"
                              Content="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.timestamps}"
                              IsEnabled="{x:Bind LogsViewModel.CanChangeOptions, Mode=OneWay}"
                              IsChecked="{x:Bind LogsViewModel.Timestamps, Mode=TwoWay}" />
                    <CheckBox VerticalAlignment="Center"
                              Content="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.auto-scroll}"
                              IsChecked="{x:Bind LogsViewModel.AutoScroll, Mode=TwoWay}" />
                </StackPanel>

                <TextBox Grid.Row="2" x:Name="LogBox" Style="{StaticResource CodeBoxStyle}"
                         AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.tab.logs}"
                         Text="{x:Bind LogsViewModel.LogText, Mode=OneWay}" />

                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Style="{StaticResource HintStyle}"
                               Text="{x:Bind LogsViewModel.Notice, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="{x:Bind LogsViewModel.StatusText, Mode=OneWay}" />
                </Grid>
            </Grid>

            <!-- 空状态提示 -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind HasDetail, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <FontIcon Style="{StaticResource EmptyStateIconStyle}" Glyph="&#xE9D9;" />
                <TextBlock Style="{StaticResource EmptyStateTextStyle}"
                           Text="{Binding Converter={StaticResource LocText}, ConverterParameter=container-detail.empty}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>