<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WslcDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <!-- 功能 003 · AC11:左侧导航承载各功能页面。 -->
    <NavigationView
        x:Name="Nav"
        PaneDisplayMode="Left"
        OpenPaneLength="180"
        IsSettingsVisible="False"
        IsBackButtonVisible="Collapsed"
        SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="容器" Tag="containers">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A1;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="镜像" Tag="images">
                <NavigationViewItem.Icon>
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8F1;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <Grid x:Name="PageHost" />
    </NavigationView>
</Window>