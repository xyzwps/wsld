<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WslcDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <!-- 功能 009 · AC1:自定义标题栏(可拖拽区 = 第一行),第二行是导航 + 页面。
         标题栏里的文字一律在代码里赋值:Window 根上不能用 x:Bind 的转换器模板(dev-notes §2)。 -->
    <!-- 窗口底色必须显式给:Window 自己的背景跟着应用级主题走,
         而我们是把主题设在 Root 上的。不给底色,浅色模式下导航栏会透出深色底,黑成一片。 -->
    <Grid x:Name="Root" RowDefinitions="Auto,*"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <!-- ===== 顶条 ===== -->
        <Grid x:Name="DragHost" Grid.Row="0"
              ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              MinHeight="46"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">

            <Button x:Name="PaneToggle" Grid.Column="0"
                    Style="{StaticResource TitleBarIconButtonStyle}"
                    Margin="6,0,0,0"
                    Click="PaneToggle_Click">
                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE700;" FontSize="15" />
            </Button>

            <!-- 品牌图标 -->
            <Border Grid.Column="1" Width="24" Height="24" Margin="8,0,10,0"
                    CornerRadius="6" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE8A1;"
                          FontSize="14" Foreground="White" />
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="AppTitleText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="WSLC Desktop" />
                <TextBlock x:Name="PageTitleText"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="" />
            </StackPanel>

            <!-- 右侧动作区;Padding.Right 由代码按系统标题栏留白(RightInset)算,免得被最小化/关闭按钮压住 -->
            <StackPanel Grid.Column="5"
                        x:Name="TitleActions"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                <Button x:Name="ThemeButton"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        Click="ThemeButton_Click">
                    <FontIcon x:Name="ThemeGlyph" FontFamily="{StaticResource IconFont}" Glyph="&#xE706;" FontSize="15" />
                </Button>
                <Button x:Name="SettingsButton"
                        Style="{StaticResource TitleBarIconButtonStyle}"
                        Margin="0,0,4,0"
                        Click="SettingsButton_Click">
                    <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE713;" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== 导航 + 页面 ===== -->
        <NavigationView Grid.Row="1"
                        x:Name="Nav"
                        PaneDisplayMode="Left"
                        OpenPaneLength="180"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="containers">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE8A1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="images">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- 功能 012:命令编排 -->
                <NavigationViewItem Tag="run">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE756;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid x:Name="PageHost" />
        </NavigationView>
    </Grid>
</Window>