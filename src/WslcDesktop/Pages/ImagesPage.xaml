<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WslcDesktop.Pages.ImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WslcDesktop.Core.ViewModels"
    xmlns:m="using:WslcDesktop.Core.Models"
>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- 错误条(功能 003 · AC7) -->
        <InfoBar Grid.Row="0"
                 Margin="12,12,12,0"
                 Severity="Error"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 IsClosable="False"
                 Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

        <!-- 工具栏(功能 003 · AC12:没有自动刷新,只有手动刷新) -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="12,12,12,0">
            <TextBox x:Name="SearchBox"
                     PlaceholderText="搜索仓库名 / 标签 / ID"
                     Width="280"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Content="刷新" VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.RefreshCommand}" />
        </Grid>

        <!-- 汇总(AC10) -->
        <TextBlock Grid.Row="2"
                   Margin="12,12,12,4"
                   Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Border Grid.Row="3" Height="1" Margin="12,0"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- 镜像列表 -->
        <Grid Grid.Row="4" Margin="12,4,12,0">
            <ListView x:Name="ImageList"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="m:ImageInfo">
                        <StackPanel Spacing="3" Padding="0,6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center"
                                        Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName, Mode=OneTime}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneTime}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="20,0,0,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind SubtleLine, Mode=OneTime}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind UsageText, Mode=OneTime}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyHint"
                       Text="没有匹配的镜像"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <!-- 状态栏:刷新时间 + 手动刷新提示(AC12) -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="6" Margin="12,8,12,10">
            <TextBlock FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="{x:Bind ViewModel.LastRefreshedAtText, Mode=OneWay}" />
            <TextBlock FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="· 镜像不会自动变化,需要时点右上角刷新" />
        </StackPanel>
    </Grid>
</Page>