<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WslcDesktop.Pages.ImagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WslcDesktop.Core.ViewModels"
>
    <!-- 功能 009 · AC4/AC5:按钮换成图标,静态文案走 Localizer(页面 DataContext = Localizer.Default)。
         删除按钮的悬停说明会随"是否已升级为强制删除"变化,那个绑的是行对象上的属性。 -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

        <!-- 失败提示(功能 003 · AC7 / 功能 004 · AC9:失败不丢数据) -->
        <InfoBar Grid.Row="0"
                 Margin="12,12,12,0"
                 Severity="Error"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 IsClosable="False"
                 Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

        <!-- 成功提示(功能 004 · AC14:绿色 InfoBar) -->
        <InfoBar Grid.Row="1"
                 Margin="12,12,12,0"
                 Severity="Success"
                 IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                 IsClosable="False"
                 Message="{x:Bind ViewModel.Notice, Mode=OneWay}" />

        <!-- 拉取区(功能 004 · AC14) -->
        <Border Grid.Row="2"
                Margin="12,12,12,0"
                Padding="12"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8" RowSpacing="8">

                <TextBox x:Name="PullBox"
                         Grid.Row="0" Grid.Column="0"
                         PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=images.pull.placeholder}"
                         Text="{x:Bind ViewModel.PullText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="PullBox_KeyDown" />

                <Button Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource AccentIconButtonStyle}"
                        Content="&#xE896;"
                        ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=images.pull.tooltip}"
                        AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=action.pull}"
                        Command="{x:Bind ViewModel.PullCommand, Mode=OneTime}"
                        IsEnabled="{x:Bind ViewModel.CanPull, Mode=OneWay}" />

                <Button x:Name="CancelButton"
                        Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource IconOnlyButtonStyle}"
                        Content="&#xE711;"
                        ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=images.cancel.tooltip}"
                        AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=action.cancel}"
                        Command="{x:Bind ViewModel.CancelPullCommand, Mode=OneTime}"
                        Visibility="{x:Bind ViewModel.IsPulling, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

                <!-- 进度(功能 004 · AC7:实测拿不到百分比,只报"在做什么 + 已等待几秒") -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                            Orientation="Horizontal" Spacing="8"
                            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                                  IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.BusyText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工具栏(功能 003 · AC12:不自动轮询,只有手动刷新) -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="12,12,12,0">
            <TextBox x:Name="SearchBox"
                     PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=images.search.placeholder}"
                     Width="280"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Bottom"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    Style="{StaticResource IconOnlyButtonStyle}"
                    Content="&#xE895;"
                    VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=images.refresh.tooltip}"
                    AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=action.refresh}"
                    Command="{x:Bind ViewModel.RefreshCommand, Mode=OneTime}" />
        </Grid>

        <!-- 汇总(AC10) -->
        <TextBlock Grid.Row="4"
                   Margin="12,12,12,4"
                   Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Border Grid.Row="5" Height="1" Margin="12,0"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- 镜像列表 -->
        <Grid Grid.Row="6" Margin="12,4,12,0">
            <ListView x:Name="ImageList"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImageItemViewModel">
                        <StackPanel Spacing="3" Padding="0,6" AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="12" Height="12" CornerRadius="3" VerticalAlignment="Center"
                                        Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName, Mode=OneWay}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}"
                                           VerticalAlignment="Center" />

                                <!-- 删除操作(功能 004 · AC10/AC11,功能 009 · AC4:图标化) -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <ProgressRing Width="16" Height="16" VerticalAlignment="Center"
                                                  IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                  Visibility="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource DangerIconButtonStyle}"
                                            Content="&#xE74D;"
                                            ToolTipService.ToolTip="{x:Bind RemoveTooltip, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind RemoveLabel, Mode=OneWay}"
                                            IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                                            Click="RemoveButton_Click" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="20,0,0,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind SubtleLine, Mode=OneWay}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- 被容器引用时用警示色标出,并说明按钮会变成什么 -->
                                <TextBlock Grid.Column="1" FontSize="12"
                                           Text="{x:Bind UsageText, Mode=OneWay}"
                                           Visibility="{x:Bind IsInUse, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Grid.Column="1" FontSize="12"
                                           Text="{x:Bind UsageText, Mode=OneWay}"
                                           Visibility="{x:Bind IsInUse, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyHint"
                       Text="{Binding Converter={StaticResource LocText}, ConverterParameter=images.empty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <!-- 状态栏 -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" Spacing="6" Margin="12,8,12,10">
            <TextBlock FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="{x:Bind ViewModel.LastRefreshedAtText, Mode=OneWay}" />
            <TextBlock FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="{Binding Converter={StaticResource LocText}, ConverterParameter=images.footer}" />
        </StackPanel>
    </Grid>
</Page>