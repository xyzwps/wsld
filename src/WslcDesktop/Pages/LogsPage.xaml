<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WslcDesktop.Pages.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 功能 005 · AC16:日志页 = 选项行(容器/行数/时间戳/跟随/自动滚动)+ 只读等宽日志区 + 状态栏。
         功能 009 · AC4/AC5:三个动作按钮换成图标,静态文案走 Localizer(页面 DataContext = Localizer.Default)。 -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- 错误条与提示条:失败红色、"这个容器没有输出"这类正常情况绿色(AC10)。 -->
        <InfoBar Grid.Row="0"
                 Margin="12,12,12,0"
                 Severity="Error"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 IsClosable="False"
                 Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

        <InfoBar Grid.Row="1"
                 Margin="12,12,12,0"
                 Severity="Success"
                 IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                 IsClosable="False"
                 Message="{x:Bind ViewModel.Notice, Mode=OneWay}" />

        <!-- 工具栏布局约定(WinUI 3 没有 WrapPanel,靠"可伸缩列"防裁切):
             动作按钮一律放在 Auto 列里,永远保证自己的宽度;
             会变长的容器下拉放在 * 列里,窗口窄时它先缩小(文字截断),绝不把按钮挤出可视区。 -->
        <Grid Grid.Row="2" Padding="12,12,12,0" RowDefinitions="Auto,Auto">

            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <ComboBox x:Name="SourceBox"
                          Header="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.container-header}"
                          MinWidth="200"
                          MaxWidth="460"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Bottom"
                          IsEnabled="{x:Bind ViewModel.CanChangeOptions, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.Sources, Mode=OneWay}"
                          DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedSource, Mode=OneWay}"
                          SelectionChanged="Source_SelectionChanged" />
                <!-- 进度圈空闲时收起,把水平空间让给按钮。 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <ProgressRing Width="18" Height="18"
                                  Margin="0,0,4,0"
                                  VerticalAlignment="Center"
                                  IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource IconOnlyButtonStyle}"
                            Content="&#xE895;"
                            ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.refresh-sources.tooltip}"
                            AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=action.refresh-containers}"
                            Command="{x:Bind ViewModel.RefreshSourcesCommand, Mode=OneTime}" />
                    <Button Style="{StaticResource AccentIconButtonStyle}"
                            Content="&#xE768;"
                            ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.load.tooltip}"
                            AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=action.load-logs}"
                            Command="{x:Bind ViewModel.LoadCommand, Mode=OneTime}" />
                    <Button Style="{StaticResource IconOnlyButtonStyle}"
                            Content="&#xE71A;"
                            ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.stop-follow.tooltip}"
                            AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=action.stop-follow}"
                            Command="{x:Bind ViewModel.StopFollowCommand, Mode=OneTime}" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,10,0,0">
                <!-- 行数下拉固定 150 DIP:最长的条目("最近 1000 行" / "1000 lines",整数格式化不带千分位)放得下,
                     中英切换时工具栏的宽度也不会跳来跳去。不给固定宽度时它按内容要宽(实测英文 107 DIP / 中文 124 DIP);
                     注意 ComboBox 的 UIA 矩形会把下拉的占位一起算进去,量出来比框本身宽得多,
                     别拿那个数字判断要不要限宽(dev-notes #23)。 -->
                <ComboBox x:Name="TailBox"
                          Header="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.lines-header}"
                          Width="150"
                          VerticalAlignment="Bottom"
                          IsEnabled="{x:Bind ViewModel.CanChangeOptions, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.TailOptions, Mode=OneWay}"
                          DisplayMemberPath="Label"
                          SelectedItem="{x:Bind ViewModel.SelectedTail, Mode=OneWay}"
                          SelectionChanged="Tail_SelectionChanged" />
                <!-- MinWidth=0:开关的开关/关状态文字相同,去掉默认 154 的最小宽度后一行能放下全部选项。 -->
                <ToggleSwitch x:Name="TimestampsSwitch"
                              MinWidth="0"
                              OnContent="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.timestamps}"
                              OffContent="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.timestamps}"
                              VerticalAlignment="Bottom"
                              IsEnabled="{x:Bind ViewModel.CanChangeOptions, Mode=OneWay}"
                              IsOn="{x:Bind ViewModel.Timestamps, Mode=TwoWay}" />
                <ToggleSwitch x:Name="FollowSwitch"
                              MinWidth="0"
                              OnContent="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.follow}"
                              OffContent="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.follow}"
                              VerticalAlignment="Bottom"
                              ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.follow.tooltip}"
                              IsEnabled="{x:Bind ViewModel.CanFollow, Mode=OneWay}"
                              IsOn="{x:Bind ViewModel.FollowRequested, Mode=TwoWay}" />
                <ToggleSwitch x:Name="AutoScrollSwitch"
                              MinWidth="0"
                              OnContent="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.auto-scroll}"
                              OffContent="{Binding Converter={StaticResource LocText}, ConverterParameter=logs.auto-scroll}"
                              VerticalAlignment="Bottom"
                              IsOn="{x:Bind ViewModel.AutoScroll, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Margin="12,10,12,0"
                BorderThickness="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                CornerRadius="4">
            <!-- 日志区:只读等宽、不换行(横向滚动)、可全选复制(AC16)。 -->
            <TextBox x:Name="LogBox"
                     Padding="10"
                     BorderThickness="0"
                     Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                     FontFamily="Consolas, Cascadia Mono, Courier New"
                     FontSize="12"
                     IsReadOnly="True"
                     IsSpellCheckEnabled="False"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     Text="{x:Bind ViewModel.LogText, Mode=OneWay}" />
        </Border>

        <!-- 状态栏:行数 · 丢弃计数 · 最近加载时间 · 跟随/缓冲状态(AC13/AC16)。 -->
        <TextBlock Grid.Row="4"
                   Margin="12,8,12,10"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
    </Grid>
</Page>
