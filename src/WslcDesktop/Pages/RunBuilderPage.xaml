<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WslcDesktop.Pages.RunBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:WslcDesktop.Core.Models"
>
    <!-- 功能 012:wslc run 的可视化编排。左边填表,右边实时长出命令,复制走或者就地跑。
         表单状态全在 RunSpec,拼命令 / 校验 / 读回全在 RunCommandBuilder,这一层只管呈现。
         静态文案走 LocText 转换器(页面 DataContext = Localizer.Default);换语言时主窗口会重建本页。
         右列定宽 420:星号列不会缩到内容以下(dev-notes §31),给它固定宽度才不会把表单挤扁。 -->
    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="MaxWidth" Value="520" />
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="170" />
        </Style>
        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- 行内小输入框:宽度写死,谁也不跟谁抢星号列 -->
        <Style x:Key="RowBoxStyle" TargetType="TextBox">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 行内下拉框另起一个样式:Style 的 TargetType 和元素类型不符,
             编译期一声不吭,要等模板真正实例化时才抛 XamlParseException,
             也就是点「添加端口」长出新行的那一刻才炸(dev-notes 第 37 节)。 -->
        <Style x:Key="RowComboStyle" TargetType="ComboBox">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <Grid ColumnDefinitions="*,420">

        <!-- ==================== 左:表单 ==================== -->
        <ScrollViewer Grid.Column="0" Padding="20,16,20,24" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700" HorizontalAlignment="Left" Spacing="12">

                <!-- 基本信息 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.section.basic}" />

                        <!-- AutoSuggestBox 而不是可编辑 ComboBox:后者没有 TextChanged 事件,
                             敲进去的字要等失焦才提交,右边那条命令就会慢半拍。 -->
                        <AutoSuggestBox x:Name="ImageBox" Width="430"
                                  Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.field.image}"
                                  PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.image.placeholder}"
                                  AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.field.image}"
                                  ItemsSource="{x:Bind ViewModel.ImageReferences, Mode=OneWay}"
                                  Text="{x:Bind ViewModel.Spec.Image, Mode=TwoWay}"
                                  TextChanged="ImageBox_TextChanged" />

                        <TextBox Style="{StaticResource FieldStyle}" Width="430"
                                 Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.field.name}"
                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.field.name.placeholder}"
                                 Text="{x:Bind ViewModel.Spec.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- 默认勾上后台运行:点"就地执行"才不必干等容器退出 -->
                        <ToggleSwitch MinWidth="0" Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.detach}"
                                      OnContent="" OffContent=""
                                      IsOn="{x:Bind ViewModel.Spec.Detach, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.detach.hint}" />

                        <CheckBox Content="{Binding Converter={StaticResource LocText}, ConverterParameter=run.rm}"
                                  IsChecked="{x:Bind ViewModel.Spec.Rm, Mode=TwoWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox Content="{Binding Converter={StaticResource LocText}, ConverterParameter=run.interactive}"
                                      IsChecked="{x:Bind ViewModel.Spec.Interactive, Mode=TwoWay}" />
                            <CheckBox Content="{Binding Converter={StaticResource LocText}, ConverterParameter=run.tty}"
                                      IsChecked="{x:Bind ViewModel.Spec.Tty, Mode=TwoWay}" />
                            <CheckBox Content="{Binding Converter={StaticResource LocText}, ConverterParameter=run.publish-all}"
                                      IsChecked="{x:Bind ViewModel.Spec.PublishAll, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- 候选项给纯字符串,不写内联 ComboBoxItem:那种写法的 Content 要延后求值,
                             初始化时选框里是空的(实测,dev-notes §39)。 -->
                        <ComboBox Style="{StaticResource ComboStyle}"
                                  Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.pull}"
                                  ItemsSource="{x:Bind PullPolicyOptions}"
                                  SelectedIndex="{x:Bind ViewModel.PullPolicyIndex, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- 初始化命令 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.section.command}" />
                        <TextBox Style="{StaticResource FieldStyle}" Width="430"
                                 Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.field.entrypoint}"
                                 Text="{x:Bind ViewModel.Spec.Entrypoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Style="{StaticResource FieldStyle}" Width="430"
                                 Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.field.command}"
                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.field.command.placeholder}"
                                 Text="{x:Bind ViewModel.Spec.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Style="{StaticResource FieldStyle}" Width="520"
                                 Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.field.args}"
                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.field.args.placeholder}"
                                 Text="{x:Bind ViewModel.Spec.Arguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <!-- 端口映射 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.section.ports}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Spec.Ports, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:PortRow">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.section.ports}">
                                        <TextBox Style="{StaticResource RowBoxStyle}" Width="120"
                                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.port.hostip.placeholder}"
                                                 Text="{x:Bind HostIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Style="{StaticResource RowBoxStyle}" Width="170"
                                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.port.host.placeholder}"
                                                 Text="{x:Bind HostPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Style="{StaticResource RowBoxStyle}" Width="150"
                                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.port.container.placeholder}"
                                                 Text="{x:Bind ContainerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox Style="{StaticResource RowComboStyle}" Width="86"
                                                  AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.port.protocol}"
                                                  SelectedIndex="{x:Bind ProtocolIndex, Mode=TwoWay}">
                                            <x:String>tcp</x:String>
                                            <x:String>udp</x:String>
                                        </ComboBox>
                                        <Button Tag="port" Style="{StaticResource DangerIconButtonStyle}" Content="&#xE74D;"
                                                Click="RemoveRow_Click"
                                                ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=run.row.remove.tooltip}"
                                                AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.row.remove.tooltip}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource AddButtonStyle}"
                                Content="{Binding Converter={StaticResource LocText}, ConverterParameter=run.add-port}"
                                Command="{x:Bind ViewModel.AddPortCommand, Mode=OneTime}" />
                    </StackPanel>
                </Border>

                <!-- 文件系统:挂载 + tmpfs -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.section.storage}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Spec.Volumes, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:VolumeRow">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.section.storage}">
                                        <TextBox Style="{StaticResource RowBoxStyle}" Width="240"
                                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.volume.source.placeholder}"
                                                 Text="{x:Bind Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Style="{StaticResource RowBoxStyle}" Width="210"
                                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.volume.target.placeholder}"
                                                 Text="{x:Bind Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox VerticalAlignment="Center"
                                                  Content="{Binding Converter={StaticResource LocText}, ConverterParameter=run.volume.ro}"
                                                  IsChecked="{x:Bind ReadOnly, Mode=TwoWay}" />
                                        <Button Tag="volume" Style="{StaticResource DangerIconButtonStyle}" Content="&#xE74D;"
                                                Click="RemoveRow_Click"
                                                ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=run.row.remove.tooltip}"
                                                AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.row.remove.tooltip}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource AddButtonStyle}"
                                Content="{Binding Converter={StaticResource LocText}, ConverterParameter=run.add-volume}"
                                Command="{x:Bind ViewModel.AddVolumeCommand, Mode=OneTime}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Spec.TmpfsPaths, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:PathRow">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.tmpfs.placeholder}">
                                        <TextBox Style="{StaticResource RowBoxStyle}" Width="330"
                                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.tmpfs.placeholder}"
                                                 Text="{x:Bind Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Tag="tmpfs" Style="{StaticResource DangerIconButtonStyle}" Content="&#xE74D;"
                                                Click="RemoveRow_Click"
                                                ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=run.row.remove.tooltip}"
                                                AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.row.remove.tooltip}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource AddButtonStyle}"
                                Content="{Binding Converter={StaticResource LocText}, ConverterParameter=run.add-tmpfs}"
                                Command="{x:Bind ViewModel.AddTmpfsCommand, Mode=OneTime}" />
                    </StackPanel>
                </Border>

                <!-- 环境与标签 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.section.env}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Spec.EnvVars, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:EnvRow">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.section.env}">
                                        <TextBox Style="{StaticResource RowBoxStyle}" Width="170"
                                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.env.key.placeholder}"
                                                 Text="{x:Bind Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Style="{StaticResource RowBoxStyle}" Width="270"
                                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.env.value.placeholder}"
                                                 Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Tag="env" Style="{StaticResource DangerIconButtonStyle}" Content="&#xE74D;"
                                                Click="RemoveRow_Click"
                                                ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=run.row.remove.tooltip}"
                                                AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.row.remove.tooltip}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource AddButtonStyle}"
                                Content="{Binding Converter={StaticResource LocText}, ConverterParameter=run.add-env}"
                                Command="{x:Bind ViewModel.AddEnvCommand, Mode=OneTime}" />

                        <TextBox Style="{StaticResource FieldStyle}" Width="430"
                                 Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.env-file}"
                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.env-file.placeholder}"
                                 Text="{x:Bind ViewModel.Spec.EnvFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Spec.Labels, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:LabelRow">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.section.env}">
                                        <TextBox Style="{StaticResource RowBoxStyle}" Width="170"
                                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.label.key.placeholder}"
                                                 Text="{x:Bind Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Style="{StaticResource RowBoxStyle}" Width="270"
                                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.label.value.placeholder}"
                                                 Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Tag="label" Style="{StaticResource DangerIconButtonStyle}" Content="&#xE74D;"
                                                Click="RemoveRow_Click"
                                                ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=run.row.remove.tooltip}"
                                                AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.row.remove.tooltip}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource AddButtonStyle}"
                                Content="{Binding Converter={StaticResource LocText}, ConverterParameter=run.add-label}"
                                Command="{x:Bind ViewModel.AddLabelCommand, Mode=OneTime}" />
                    </StackPanel>
                </Border>

                <!-- 资源与网络 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.section.resources}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox Style="{StaticResource RowBoxStyle}" Width="180"
                                     Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.cpus}"
                                     PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.cpus.placeholder}"
                                     Text="{x:Bind ViewModel.Spec.Cpus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Style="{StaticResource RowBoxStyle}" Width="170"
                                     Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.memory}"
                                     PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.memory.placeholder}"
                                     Text="{x:Bind ViewModel.Spec.Memory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Style="{StaticResource RowBoxStyle}" Width="170"
                                     Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.shm}"
                                     PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.shm.placeholder}"
                                     Text="{x:Bind ViewModel.Spec.ShmSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox Style="{StaticResource RowBoxStyle}" Width="180"
                                     Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.hostname}"
                                     Text="{x:Bind ViewModel.Spec.Hostname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Style="{StaticResource RowBoxStyle}" Width="180"
                                     Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.network}"
                                     PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.network.placeholder}"
                                     Text="{x:Bind ViewModel.Spec.Network, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Style="{StaticResource RowBoxStyle}" Width="180"
                                     Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.user}"
                                     PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.user.placeholder}"
                                     Text="{x:Bind ViewModel.Spec.User, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <TextBox Style="{StaticResource FieldStyle}" Width="300"
                                 Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.workdir}"
                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.workdir.placeholder}"
                                 Text="{x:Bind ViewModel.Spec.Workdir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <!-- 健康检查 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.section.health}" />
                        <TextBox Style="{StaticResource FieldStyle}" Width="520"
                                 Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.health.cmd}"
                                 Text="{x:Bind ViewModel.Spec.HealthCmd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox Style="{StaticResource RowBoxStyle}" Width="140"
                                     Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.health.interval}"
                                     PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.duration.placeholder}"
                                     Text="{x:Bind ViewModel.Spec.HealthInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Style="{StaticResource RowBoxStyle}" Width="140"
                                     Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.health.timeout}"
                                     PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.duration.placeholder}"
                                     Text="{x:Bind ViewModel.Spec.HealthTimeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Style="{StaticResource RowBoxStyle}" Width="110"
                                     Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.health.retries}"
                                     Text="{x:Bind ViewModel.Spec.HealthRetries, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Style="{StaticResource RowBoxStyle}" Width="140"
                                     Header="{Binding Converter={StaticResource LocText}, ConverterParameter=run.health.start}"
                                     PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.duration.placeholder}"
                                     Text="{x:Bind ViewModel.Spec.HealthStartPeriod, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox Content="{Binding Converter={StaticResource LocText}, ConverterParameter=run.no-healthcheck}"
                                  IsChecked="{x:Bind ViewModel.Spec.NoHealthcheck, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- 其他参数:表单没覆盖的选项原样追加,不必为了一个 dns 开关退回终端重写整条命令 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}"
                                   Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.section.extras}" />
                        <TextBox Style="{StaticResource FieldStyle}" Width="620" MaxWidth="620"
                                 PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.extras.placeholder}"
                                 Text="{x:Bind ViewModel.Spec.ExtraArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 右:生成的命令 + 就地执行 ==================== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="0,16,20,24">

            <InfoBar Grid.Row="0" Margin="0,0,0,10" Severity="Error" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

            <InfoBar Grid.Row="1" Margin="0,0,0,10" Severity="Success" IsClosable="False"
                     IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                     Message="{x:Bind ViewModel.Notice, Mode=OneWay}" />

            <!-- 所见即所跑:这一条既是预览,也是真正执行的参数(RunCommandBuilder 同一来源) -->
            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionHeaderStyle}"
                               Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.command.title}" />
                    <TextBox x:Name="CommandBox" MaxHeight="150" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="12" TextWrapping="Wrap"
                             BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.command.title}"
                             Text="{x:Bind ViewModel.GeneratedCommand, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CopyButton" Click="CopyButton_Click" Padding="10,5" MinWidth="0"
                                IsEnabled="{x:Bind ViewModel.CanCopy, Mode=OneWay}"
                                ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=run.copy.tooltip}"
                                AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.copy}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock FontSize="13" Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.copy}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportButton" Click="ImportButton_Click" Padding="10,5" MinWidth="0"
                                IsEnabled="{x:Bind ViewModel.CanImport, Mode=OneWay}"
                                ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=run.import.tooltip}"
                                AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.import}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE77F;" FontSize="14" />
                                <TextBlock FontSize="13" Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.import}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 校验:还差什么一次说全;没补齐之前复制与执行都不放行 -->
                    <StackPanel Spacing="2"
                                Visibility="{x:Bind ViewModel.HasValidationIssues, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.errors.title}" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                   Text="{x:Bind ViewModel.ValidationText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,12">
                <Button Style="{ThemeResource AccentButtonStyle}" MinWidth="0" Padding="12,6"
                        Command="{x:Bind ViewModel.ExecuteCommand, Mode=OneTime}"
                        AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.execute}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource IconFont}" Glyph="&#xE768;" FontSize="14" />
                        <TextBlock FontSize="13" Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.execute}" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0"
                            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                    <ProgressRing Width="16" Height="16" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.executing}" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource IconOnlyButtonStyle}" Content="&#xE711;"
                        Command="{x:Bind ViewModel.CancelCommand, Mode=OneTime}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                        ToolTipService.ToolTip="{Binding Converter={StaticResource LocText}, ConverterParameter=run.cancel.tooltip}"
                        AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=action.cancel}" />
            </Grid>

            <!-- 执行输出:后台模式秒回容器 ID;前台模式(取消勾选后台运行)容器输出逐行流到这里 -->
            <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Style="{StaticResource SectionHeaderStyle}"
                               Text="{Binding Converter={StaticResource LocText}, ConverterParameter=run.output.title}" />
                    <TextBox Grid.Row="1" x:Name="OutputBox" Margin="0,8,0,0" IsReadOnly="True" IsTabStop="False"
                             AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="1"
                             BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                             Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                             FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="12"
                             PlaceholderText="{Binding Converter={StaticResource LocText}, ConverterParameter=run.output.placeholder}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{Binding Converter={StaticResource LocText}, ConverterParameter=run.output.title}"
                             Text="{x:Bind ViewModel.OutputText, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
