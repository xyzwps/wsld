<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WslcDesktop.Pages.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WslcDesktop.Core.ViewModels"
>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- 错误条(功能 001 · AC1 / 功能 002 · AC8) -->
        <InfoBar Grid.Row="0"
                 Margin="12,12,12,0"
                 Severity="Error"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 IsClosable="False"
                 Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

        <!-- 工具栏 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="12,12,12,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox x:Name="SearchBox"
                         PlaceholderText="搜索名称 / 镜像 / ID"
                         Width="260"
                         VerticalAlignment="Bottom"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ToggleSwitch x:Name="ShowStoppedToggle"
                              OnContent="显示已停止" OffContent="隐藏已停止"
                              VerticalAlignment="Bottom"
                              IsOn="{x:Bind ViewModel.ShowStopped, Mode=TwoWay}" />
                <ComboBox x:Name="IntervalBox"
                          Header="自动刷新"
                          VerticalAlignment="Bottom"
                          SelectionChanged="Interval_Changed">
                    <ComboBoxItem Tag="0">关闭</ComboBoxItem>
                    <ComboBoxItem Tag="2">2 秒</ComboBoxItem>
                    <ComboBoxItem Tag="5">5 秒</ComboBoxItem>
                    <ComboBoxItem Tag="10">10 秒</ComboBoxItem>
                    <ComboBoxItem Tag="30">30 秒</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <ProgressRing x:Name="BusyRing"
                              Width="18" Height="18"
                             
                              Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                <Button Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- 汇总 -->
        <TextBlock Grid.Row="2"
                   Margin="12,12,12,4"
                   Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Border Grid.Row="3" Height="1" Margin="12,0"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- 容器列表 -->
        <Grid Grid.Row="4" Margin="12,4,12,0">
            <ListView x:Name="ContainerList"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContainerItemViewModel">
                        <StackPanel Spacing="3" Padding="0,6" AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                         Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                         Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName, Mode=OneWay}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="220"
                                           VerticalAlignment="Center" />

                                <!-- 生命周期操作(功能 002) -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                            VerticalAlignment="Center">
                                    <ProgressRing Width="16" Height="16"
                                                  IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                  Visibility="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                    <Button Padding="8,4" MinWidth="0"
                                          Content="启动"
                                          ToolTipService.ToolTip="启动容器 (wslc start)"
                                          IsEnabled="{x:Bind CanStart, Mode=OneWay}"
                                          Command="{x:Bind StartCommand, Mode=OneTime}" />
                                    <Button Padding="8,4" MinWidth="0"
                                          Content="停止"
                                          ToolTipService.ToolTip="停止容器 (wslc stop)"
                                          IsEnabled="{x:Bind CanStop, Mode=OneWay}"
                                          Command="{x:Bind StopCommand, Mode=OneTime}" />
                                    <Button Padding="8,4" MinWidth="0"
                                          Content="重启"
                                          ToolTipService.ToolTip="重启容器 (wslc restart)"
                                          IsEnabled="{x:Bind CanRestart, Mode=OneWay}"
                                          Command="{x:Bind RestartCommand, Mode=OneTime}" />
                                    <Button Padding="8,4" MinWidth="0"
                                          Content="删除"
                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                          ToolTipService.ToolTip="删除容器 (wslc remove)"
                                          IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                                          Click="RemoveButton_Click" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{x:Bind ImageLine, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind SubtleLine, Mode=OneWay}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyHint"
                       Text="没有匹配的容器"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="5"
                   Margin="12,8,12,10"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="{x:Bind ViewModel.LastRefreshedAtText, Mode=OneWay}" />
    </Grid>
</Page>