<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WslcDesktop.Pages.ContainersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:WslcDesktop.Core.Models"
>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

        <!-- 错误条(功能 001 · AC1) -->
        <InfoBar Grid.Row="0"
                 Margin="12,12,12,0"
                 Severity="Error"
                 IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                 IsClosable="False"
                 Message="{x:Bind ViewModel.Error, Mode=OneWay}" />

        <!-- 工具栏 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="12,12,12,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBox x:Name="SearchBox"
                         PlaceholderText="搜索名称 / 镜像 / ID"
                         Width="280"
                         VerticalAlignment="Bottom"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ToggleSwitch x:Name="ShowStoppedToggle"
                              OnContent="显示已停止" OffContent="隐藏已停止"
                              VerticalAlignment="Bottom"
                              IsOn="{x:Bind ViewModel.ShowStopped, Mode=TwoWay}" />
                <ComboBox x:Name="IntervalBox"
                          Header="自动刷新"
                          VerticalAlignment="Bottom"
                          SelectionChanged="Interval_Changed">
                    <ComboBoxItem Tag="0">关闭</ComboBoxItem>
                    <ComboBoxItem Tag="2">2 秒</ComboBoxItem>
                    <ComboBoxItem Tag="5">5 秒</ComboBoxItem>
                    <ComboBoxItem Tag="10">10 秒</ComboBoxItem>
                    <ComboBoxItem Tag="30">30 秒</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Bottom"
                    Content="刷新" Command="{x:Bind ViewModel.RefreshCommand}" />
        </Grid>

        <!-- 汇总 -->
        <TextBlock Grid.Row="2"
                   Margin="12,12,12,4"
                   Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                   Style="{ThemeResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <Border Grid.Row="3" Height="1" Margin="12,0"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- 容器列表 -->
        <Grid Grid.Row="4" Margin="12,4,12,0">
            <ListView x:Name="ContainerList"
                      ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                      SelectionMode="None"
                      IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:ContainerInfo">
                        <StackPanel Spacing="3" Padding="0,6">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                         Visibility="{x:Bind IsRunning, Converter={StaticResource BoolToVis}}" />
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{ThemeResource ControlStrongFillColorDefaultBrush}"
                                         Visibility="{x:Bind IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Status}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="260" />
                            </Grid>
                            <TextBlock Text="{x:Bind ImageLine}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind SubtleLine}" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyHint"
                       Text="没有匹配的容器"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </Grid>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="5"
                   Margin="12,8,12,10"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                   Text="{x:Bind ViewModel.LastRefreshedAtText, Mode=OneWay}" />
    </Grid>
</Page>