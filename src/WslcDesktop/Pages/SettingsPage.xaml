<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WslcDesktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 功能 009 · AC2/AC3/AC5:主题与语言都在这里,选完立即生效并写盘。
         文案在代码里赋值:换语言时整个页面会被重建,构造函数里取一次就够新。 -->
    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- 系统默认的单选项很高,横着排一排才不会把设置页撑得看不到底。 -->
        <Style x:Key="OptionStyle" TargetType="RadioButton">
            <Setter Property="Padding" Value="8,0,0,0" />
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="20,16,20,24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="10">

            <StackPanel Spacing="2">
                <TextBlock x:Name="HeaderText" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SubtitleText"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 外观 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="AppearanceHeader" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock x:Name="ThemeLabel" Style="{StaticResource RowLabelStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,4,0,0">
                        <RadioButton x:Name="ThemeSystemOption" Style="{StaticResource OptionStyle}" GroupName="theme" Tag="FollowSystem" Checked="Option_Checked" />
                        <RadioButton x:Name="ThemeLightOption" Style="{StaticResource OptionStyle}" GroupName="theme" Tag="Light" Checked="Option_Checked" />
                        <RadioButton x:Name="ThemeDarkOption" Style="{StaticResource OptionStyle}" GroupName="theme" Tag="Dark" Checked="Option_Checked" />
                    </StackPanel>
                    <TextBlock x:Name="ThemeHintText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 语言 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="LanguageHeader" Style="{StaticResource SectionHeaderStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,4,0,0">
                        <RadioButton x:Name="LanguageSystemOption" Style="{StaticResource OptionStyle}" GroupName="language" Tag="FollowSystem" Checked="Option_Checked" />
                        <RadioButton x:Name="LanguageZhOption" Style="{StaticResource OptionStyle}" GroupName="language" Tag="ZhCn" Checked="Option_Checked" />
                        <RadioButton x:Name="LanguageEnOption" Style="{StaticResource OptionStyle}" GroupName="language" Tag="En" Checked="Option_Checked" />
                    </StackPanel>
                    <TextBlock x:Name="LanguageCurrentText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="LanguageNoteText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 镜像加速(功能 010 · AC1/AC7):填一次,拉镜像时不必再手写镜像站前缀 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="MirrorHeader" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock x:Name="MirrorLabel" Style="{StaticResource RowLabelStyle}" />
                    <TextBox x:Name="MirrorBox"
                             Width="320"
                             HorizontalAlignment="Left"
                             TextChanged="MirrorBox_TextChanged"
                             KeyDown="MirrorBox_KeyDown"
                             LostFocus="MirrorBox_LostFocus" />
                    <TextBlock x:Name="MirrorPreviewText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" />
                    <CheckBox x:Name="RenameMirrorOption"
                              Checked="RenameMirrorOption_Toggled"
                              Unchecked="RenameMirrorOption_Toggled" />
                    <TextBlock x:Name="MirrorNoteText"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="AboutHeader" Style="{StaticResource SectionHeaderStyle}" />
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="VersionLabel" Style="{StaticResource RowLabelStyle}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionValue" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="WslcLabel" Style="{StaticResource RowLabelStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="WslcValue" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Grid.Column="0" x:Name="FileLabel" Style="{StaticResource RowLabelStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FileValue" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>